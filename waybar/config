{
  "layer": "top",
  "position": "bottom",

  "modules-left": [
    "hyprland/window",
    "custom/arrow7",
  ],

  "modules-right": [
    "custom/arrow6",
    "pulseaudio",
    "custom/arrow5",
    "network",
    "custom/arrow4",
    "memory",
    "custom/arrow3",
    "hyprland/language",
    "custom/arrow2",
    "tray",
    "clock#date",
    "custom/arrow1",
    "clock#time"
  ],

  // Модули

  "clock#time": {
    "interval": 10,
    "format": "{:%H:%M}",
    "tooltip": false
  },

  "clock#date": {
    "interval": 20,
    "format": "{:%e %b %Y}",
    "tooltip": false
  },

  "cpu": {
    "interval": 5,
    "tooltip": false,
    "format": " {usage}%",
    "format-alt": " {load}",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "hyprland/language": {
    "format": "   {}",
    "min-length": 5,
    "on-click": "hyprctl switchxkblayout $(hyprctl devices -j | jq -r '.keyboards[0].name') next",
    "tooltip": false
  },

  "memory": {
    "interval": 5,
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "tooltip": false
  },

  "network": {
    "interval": 5,
    "format-wifi": " ",
    "format-ethernet": " ",
    "format-disconnected": "No connection",
    "format-alt": " {ipaddr}/{cidr}",
    "tooltip": false
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 30,
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{icon} {name}",
    "tooltip": false,
    "all-outputs": true,
    "on-click": "activate",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": ""
    }
  },

  "pulseaudio": {
    "format": "{icon}   {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "headphone": " ",
      "hands-free": "",
      "headset": " ",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "scroll-step": 1,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false
  },

  "temperature": {
    "critical-threshold": 90,
    "interval": 5,
    "format": "{icon} {temperatureC}°",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": false
  },

  "tray": {
    "icon-size": 18
  },

  // Украшения-стрелочки

  "custom/arrow1": { "format": "", "tooltip": false },
  "custom/arrow2": { "format": "", "tooltip": false },
  "custom/arrow3": { "format": "", "tooltip": false },
  "custom/arrow4": { "format": "", "tooltip": false },
  "custom/arrow5": { "format": "", "tooltip": false },
  "custom/arrow6": { "format": "", "tooltip": false },
  "custom/arrow7": { "format": "", "tooltip": false },
}

